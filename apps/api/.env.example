NODE_ENV=development
HOST=127.0.0.1
PORT=9012
CORS_ORIGINS=http://127.0.0.1:9011,http://localhost:9011
# Leave empty to use the in-memory developer repository and developer session.
DATABASE_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://127.0.0.1:9012
DEV_AUTH_AUTO_LOGIN=true
DEV_AUTH_EMAIL=admin@local.usm
DEV_AUTH_PASSWORD=usm-local-dev
ERP_STATIC_DIR=../erp/dist
# Optional: Fastify proxies non-API requests to the ERP Vite server.
ERP_DEV_SERVER_URL=http://127.0.0.1:9013
# JSON map keyed by materialCode/code/spec/name: {"USM-001":12500}
PRICE_BOOK_JSON={}
