{
  "name": "@usm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start:dev": "tsx src/server.ts",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && tsup",
    "start": "node dist/server.js",
    "auth:bootstrap": "tsx src/bootstrap.ts --run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/http-proxy": "^11.0.0",
    "@fastify/static": "^8.0.0",
    "@usm/contracts": "file:../../packages/contracts",
    "@usm/domain": "file:../../packages/domain",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.20.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
