NODE_ENV=production
PUBLIC_DOMAIN=configurator.example.com
PUBLIC_ORIGIN=https://configurator.example.com
GATEWAY_PORT=18080

POSTGRES_DB=usm_erp
POSTGRES_USER=usm_erp
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://usm_erp:replace-with-a-long-random-password@postgres:5432/usm_erp

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=https://configurator.example.com
CORS_ORIGINS=https://configurator.example.com
SESSION_COOKIE_SECURE=true

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-on-first-login
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ORGANIZATION_NAME=Headquarters
BOOTSTRAP_ORGANIZATION_SLUG=headquarters

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=usm-erp
S3_ACCESS_KEY=usm-erp
S3_SECRET_KEY=replace-with-a-long-random-password
MINIO_ROOT_USER=usm-erp
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
