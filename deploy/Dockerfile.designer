FROM node:24-alpine AS build
WORKDIR /app
RUN npm config set registry https://registry.npmmirror.com && npm install --global pnpm@11.7.0
ENV npm_config_registry=https://registry.npmmirror.com \
    pnpm_config_fetch_retries=10 \
    pnpm_config_fetch_retry_mintimeout=20000 \
    pnpm_config_fetch_retry_maxtimeout=900000 \
    pnpm_config_fetch_timeout=600000
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps ./apps
COPY packages ./packages
RUN --mount=type=cache,id=pnpm-store,target=/root/.local/share/pnpm/store pnpm install --frozen-lockfile
COPY index.html tsconfig.json vite.config.ts ./
COPY src ./src
COPY public ./public
ARG VITE_ERP_URL
ARG VITE_ERP_APP_PATH=/erp
ARG VITE_ERP_AUTH_REQUIRED=true
ENV VITE_ERP_URL=$VITE_ERP_URL
ENV VITE_ERP_APP_PATH=$VITE_ERP_APP_PATH
ENV VITE_ERP_AUTH_REQUIRED=$VITE_ERP_AUTH_REQUIRED
RUN pnpm build:designer

FROM nginx:1.29-alpine
COPY deploy/nginx-designer.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 8080
